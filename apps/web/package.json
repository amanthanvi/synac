{
  "name": "@synac/web",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "format": "prettier . --check --ignore-path ../../.prettierignore",
    "format:write": "prettier . --write --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@clerk/nextjs": "6.36.5",
    "@synac/db": "workspace:*",
    "@synac/shared": "workspace:*",
    "next": "16.1.1",
    "pg-boss": "^12.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prettier": "^3.7.4",
    "typescript": "^5",
    "vitest": "^4.0.17"
  }
}
