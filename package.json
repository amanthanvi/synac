{
  "name": "synac",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "homepage": "https://synac.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/amanthanvi/synac.git"
  },
  "bugs": {
    "url": "https://github.com/amanthanvi/synac/issues"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel --if-present dev",
    "gate": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm tagging:check && corepack pnpm content:check && corepack pnpm content:history && corepack pnpm build",
    "content:check": "corepack pnpm --filter @synac/content-tools check",
    "content:history": "corepack pnpm --filter @synac/content-tools check:history",
    "content:compile": "corepack pnpm --filter @synac/content-tools compile",
    "build": "corepack pnpm -r build",
    "start": "corepack pnpm --filter @synac/web start",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r --workspace-concurrency=1 test && corepack pnpm test:convex",
    "test:convex": "vitest run -c vitest.convex.config.ts",
    "tagging:check": "corepack pnpm --dir experiments/tagging/synthetic-reference run check && corepack pnpm --dir experiments/tagging/production-backfill run check",
    "format": "corepack pnpm -r format",
    "convex:dev": "convex dev",
    "convex:validate": "convex dev --once",
    "ingest": "corepack pnpm --filter @synac/ingest-tools ingest"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "postcss@<8.5.18": "^8.5.23",
      "vite": "7.3.6",
      "ws@<8.21.0": "^8.21.0",
      "sharp@<0.35.0": "^0.35.0",
      "esbuild@<0.28.1": "^0.28.1"
    }
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "convex-test": "^0.0.54",
    "eslint": "^9.39.5",
    "globals": "^17.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "convex": "^1.39.1"
  }
}
