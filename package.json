{
  "name": "synac",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "homepage": "https://synac.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/amanthanvi/synac.git"
  },
  "bugs": {
    "url": "https://github.com/amanthanvi/synac/issues"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build": "pnpm -r build",
    "start": "pnpm --filter @synac/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "db:generate": "pnpm --filter @synac/db db:generate",
    "db:migrate": "pnpm --filter @synac/db db:migrate",
    "db:seed": "pnpm --filter @synac/db db:seed",
    "db:seed:content": "pnpm --filter @synac/db db:seed:content"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.52.0"
  }
}
