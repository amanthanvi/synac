{
  "name": "synac",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "homepage": "https://synac.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/amanthanvi/synac.git"
  },
  "bugs": {
    "url": "https://github.com/amanthanvi/synac/issues"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel --if-present dev",
    "gate": "corepack pnpm lint && corepack pnpm lint:convex && corepack pnpm format && corepack pnpm typecheck && corepack pnpm typecheck:convex && corepack pnpm test && corepack pnpm tagging:check && corepack pnpm content:check && corepack pnpm content:history && corepack pnpm build",
    "content:check": "corepack pnpm --filter @synac/content-tools check",
    "content:history": "corepack pnpm --filter @synac/content-tools check:history",
    "content:compile": "corepack pnpm --filter @synac/content-tools compile",
    "build": "corepack pnpm -r build",
    "start": "corepack pnpm --filter @synac/web start",
    "lint": "corepack pnpm -r lint",
    "lint:strict": "corepack pnpm -r run lint --max-warnings=0",
    "lint:convex": "eslint convex tests",
    "typecheck": "corepack pnpm -r typecheck",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "test": "corepack pnpm -r --workspace-concurrency=1 test && corepack pnpm test:convex",
    "test:convex": "vitest run -c vitest.convex.config.ts",
    "tagging:check": "corepack pnpm --dir experiments/tagging/synthetic-reference run check && corepack pnpm --dir experiments/tagging/production-backfill run check",
    "format": "corepack pnpm -r format",
    "version:check": "node scripts/checkVersions.mjs",
    "convex:dev": "convex dev",
    "convex:validate": "convex dev --once",
    "ingest": "corepack pnpm --filter @synac/ingest-tools ingest"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.5",
    "convex-test": "^0.0.54",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "convex": "^1.45.0"
  }
}
