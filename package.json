{
  "name": "synac",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "homepage": "https://synac.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/amanthanvi/synac.git"
  },
  "bugs": {
    "url": "https://github.com/amanthanvi/synac/issues"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build": "pnpm -r build",
    "start": "pnpm --filter @synac/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "format": "pnpm -r format",
    "db:generate": "pnpm --filter @synac/db db:generate",
    "db:migrate": "pnpm --filter @synac/db db:migrate",
    "db:seed": "pnpm --filter @synac/db db:seed",
    "db:seed:content": "pnpm --filter @synac/db db:seed:content"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "typescript-eslint": "^8.56.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@^3.0.0": "^3.1.4",
      "minimatch@^9.0.0": "^9.0.7",
      "vitest>picomatch": "^4.0.4",
      "rollup": "^4.59.0",
      "ajv": "^6.14.0",
      "lodash": "^4.17.23",
      "@prisma/dev>hono": "^4.12.4",
      "@prisma/dev>@hono/node-server": "^1.19.10",
      "flat-cache>flatted": "^3.4.2",
      "@prisma/config>effect": "^3.20.0",
      "micromatch>picomatch": "^2.3.2",
      "tinyglobby>picomatch": "^4.0.4"
    }
  }
}
