# Convex
CONVEX_DEPLOYMENT=""
CONVEX_URL=""
NEXT_PUBLIC_CONVEX_URL=""

# Shared secret between the Next.js server and the Convex deployment for the
# anonymous runtime mutations (view tracking, rate limiting). Set the same
# value on Vercel and in the Convex deployment's environment variables.
SYNAC_CONVEX_SERVICE_KEY=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Salts for hashing anonymous session identifiers (any random string).
SYNAC_SESSION_HASH_SALT=""
SYNAC_RATE_LIMIT_SALT=""
