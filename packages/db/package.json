{
  "name": "@synac/db",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --dir src",
    "format": "prettier . --check --ignore-path ../../.prettierignore",
    "format:write": "prettier . --write --ignore-path ../../.prettierignore",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:content": "tsx prisma/seedContent.ts",
    "db:reclassify:acronyms": "tsx prisma/reclassifyAcronymTerms.ts",
    "db:tag:auto": "tsx prisma/autoTagPublishedEntries.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "prisma": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
