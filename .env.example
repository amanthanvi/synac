# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synac?schema=public"
SHADOW_DATABASE_URL=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Clerk (apps/web)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Auth allowlists (comma-separated)
SYNAC_ADMIN_EMAILS="you@example.com"
SYNAC_EDITOR_EMAILS=""

# Worker mode (apps/worker)
# - ingest: runs scheduled/manual ingest against DATABASE_URL
# - promotion: runs staging→prod promotion jobs (requires SYNAC_STAGING_DATABASE_URL)
SYNAC_WORKER_MODE="ingest"

# Staging-first ingest (optional)
# In production, set this on `worker` (and `synac` if manual ingest triggers should target staging).
SYNAC_STAGING_DATABASE_URL=""

# Promotion controls (prod worker only; optional)
# Comma-separated list of source slugs to enable in staging via prod→staging sync.
SYNAC_STAGING_SOURCE_ALLOWLIST="nist-csrc-glossary,niccs-cisa-glossary,mitre-attack-cti,mitre-attack-mobile-cti,mitre-attack-ics-cti,ietf-rfc4949-glossary,owasp-vulnerabilities"

# When true, Tier‑1 sources auto-apply + auto-publish in prod after validation/promotion.
SYNAC_AUTOPUBLISH_TIER1="true"
