{
  "name": "@synac/shared",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run -c vitest.config.ts --dir src",
    "format": "prettier . --check --ignore-path ../../.prettierignore",
    "format:write": "prettier . --write --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
