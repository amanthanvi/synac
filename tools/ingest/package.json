{
  "name": "@synac/ingest-tools",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "ingest": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --dir src",
    "format": "prettier src --check --ignore-path ../../.prettierignore",
    "format:write": "prettier src --write --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@synac/content-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
