{
  "name": "@synac/shared",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run -c vitest.config.ts --dir src",
    "format": "prettier . --check --ignore-path ../../.prettierignore",
    "format:write": "prettier . --write --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@types/node": "^25.9.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
