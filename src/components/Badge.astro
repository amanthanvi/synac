---
export interface Props {
  label: string;
  tone?: 'accent' | 'ok' | 'warn' | 'err' | 'muted';
  size?: 'sm' | 'md';
}
const { label, tone = 'muted', size = 'md' } = Astro.props as Props;
const classes = ['badge', `badge--${tone}`, `badge--${size}`].join(' ');
---

<span class={classes}>{label}</span>