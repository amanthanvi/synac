---
export interface Props {
  sticky?: boolean;
  ariaLabel?: string;
  class?: string;
}
const { sticky = true, ariaLabel = 'Filters' } = Astro.props as Props;
const extraClass = (Astro.props as Record<string, unknown>).class as string | undefined;
const classes = ['toolbar', sticky ? 'toolbar--sticky' : '', extraClass].filter(Boolean).join(' ');
---

<div class={classes} role="toolbar" aria-label={ariaLabel}>
  <slot />
</div>