# Keep the build context small and never ship secrets or local state.

**/node_modules
**/.next
**/dist
**/build
**/.turbo
**/.cache
**/*.tsbuildinfo

# Secrets + local env
.env
.env.*
!.env.example

# VCS + tooling
.git
.github
.cursor
.idea
.claude
.vscode

# Tests / reports / artifacts
apps/e2e/test-results
apps/e2e/playwright-report
coverage
sbom.cdx.json

# Generated Prisma client (regenerated by postinstall)
packages/db/src/generated

# Docs + assets not needed at runtime
docs
*.md
!README.md
