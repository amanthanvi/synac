---
export interface Props {
  id?: string;
  title?: string;
  description?: string;
  level?: number;
  class?: string;
}
const { id, title, description, level = 2 } = Astro.props as Props;
const lvl = Math.min(6, Math.max(1, Number(level)));
const headingId = title ? `${id ?? 'section'}-title` : undefined;
const extraClass = (Astro.props as Record<string, unknown>).class as string | undefined;
const classes = ['section', extraClass].filter(Boolean).join(' ');
---

<section id={id} class={classes} aria-labelledby={headingId}>
  {title && (
    <>
      {lvl === 1 && <h1 id={headingId} class="mt-0">{title}</h1>}
      {lvl === 2 && <h2 id={headingId} class="mt-0">{title}</h2>}
      {lvl === 3 && <h3 id={headingId} class="mt-0">{title}</h3>}
      {lvl === 4 && <h4 id={headingId} class="mt-0">{title}</h4>}
      {lvl === 5 && <h5 id={headingId} class="mt-0">{title}</h5>}
      {lvl === 6 && <h6 id={headingId} class="mt-0">{title}</h6>}
    </>
  )}
  {description && <p class="muted mt-1">{description}</p>}
  <slot />
</section>